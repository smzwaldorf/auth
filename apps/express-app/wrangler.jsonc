{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "smz-app-b",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 * * * *"] },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000", "localConnectionString": "postgres://smz:smz@127.0.0.1:55432/smz_identity" }],
  "vars": {
    "AUTH_ISSUER": "https://auth.example.com/api/auth",
    "APP_A_ORIGIN": "https://app-a.example.com",
    "APP_B_ORIGIN": "https://app-b.example.com"
  }
}
