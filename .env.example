# Google Cloud Console -> OAuth client (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local persistent service. Replace every secret outside local development.
DATABASE_URL=postgres://smz:smz@localhost:5432/smz_identity
AUTH_ISSUER=http://localhost:3000/api/auth
BETTER_AUTH_SECRET=local-better-auth-secret-change-me-32-chars
APP_B_CLIENT_SECRET=local-app-b-client-secret-change-me
APP_B_COOKIE_SECRET=local-app-b-cookie-secret-change-me

# Public origins must match seeded redirects/CORS origins.
APP_A_ORIGIN=http://localhost:5173
APP_B_ORIGIN=http://localhost:4000
# Frontend build values (set these in the shell/CI for hosted builds).
VITE_AUTH_ISSUER=http://localhost:3000/api/auth
VITE_APP_B_ORIGIN=http://localhost:4000

# Passwordless login. Google remains enabled. Hosted activation requires both
# confirmed staging identities and a verified useaida.app sender in Resend.
MAGIC_LINK_ENABLED=false
MAGIC_LINK_FROM="Aida <info@useaida.app>"
RESEND_API_KEY=
STAGING_ADMIN_EMAIL=
STAGING_PARENT_EMAIL=
