# Google Cloud Console -> OAuth client (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Google requires HTTPS and does not accept raw non-localhost IP addresses.
# For a tailnet Google test, use a Tailscale HTTPS (*.ts.net) hostname here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local persistent service. Replace every secret outside local development.
DATABASE_URL=postgres://smz:smz@localhost:5432/smz_identity
AUTH_ISSUER=http://localhost:3000/api/auth
# Optional: this node's HTTPS MagicDNS hostname (without scheme/port).
# The seed command registers HTTPS callback URLs for it.
TAILSCALE_HOST=
# Optional: this node's raw tailnet IPv4 address. The seed command also
# registers HTTP callback URLs, which are useful for IP-only dev access.
TAILSCALE_IP=
# Keep the tailnet HTTPS ports separate from direct IP development ports.
TAILSCALE_AUTH_PORT=8443
TAILSCALE_APP_A_PORT=8445
TAILSCALE_APP_B_PORT=8444
BETTER_AUTH_SECRET=local-better-auth-secret-change-me-32-chars
APP_B_CLIENT_SECRET=local-app-b-client-secret-change-me
APP_B_COOKIE_SECRET=local-app-b-cookie-secret-change-me
APP_B_LISTEN_PORT=4000

# Production: POST this JSON payload ({ to, magicLinkUrl }) to your mailer.
# Development/test: the one-time URL is logged locally instead.
MAGIC_LINK_DELIVERY_WEBHOOK_URL=
MAGIC_LINK_DELIVERY_WEBHOOK_TOKEN=
DEV_LOGIN_ENABLED=true
